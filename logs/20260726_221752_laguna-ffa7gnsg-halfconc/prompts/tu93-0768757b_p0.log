from collections import deque

f = current_frame
ascii_lines = f.ascii.split('\n')

# Build the 11x11 block grid
def build_grid(ascii_lines):
    grid = []
    for br in range(11):
        row = []
        for bc in range(11):
            r = 15 + br * 3
            c = 15 + bc * 3
            row.append(ascii_lines[r + 1][c + 1])  # center cell
        grid.append(tuple(row))
    return tuple(grid)

def find_b(grid):
    for r in range(11):
        for c in range(11):
            if grid[r][c] == 'b':
                return (r, c)
    return None

def slide(grid, br, bc, dr, dc):
    """Slide the b block in direction (dr, dc). Returns new grid or None if no movement."""
    # Make a mutable copy
    grid = [list(row) for row in grid]
    
    # Current position
    cr, cc = br, bc
    
    # Slide until we hit something
    while True:
        nr, nc = cr + dr, cc + dc
        # Check bounds
        if nr < 0 or nr >= 11 or nc < 0 or nc >= 11:
            # Hit the edge - stop without moving
            return None
        cell = grid[nr][nc]
        if cell == 'B':
            # Hit a wall - stop without moving
            return None
        elif cell == 'g':
            # Slide through - move b to this position
            grid[cr][cc] = 'g'
            grid[nr][nc] = 'b'
            cr, cc = nr, nc
        elif cell == 'W':
            # Swap with W block
            grid[cr][cc] = 'W'
            grid[nr][nc] = 'b'
            return tuple(tuple(row) for row in grid)
        elif cell == 'N':
            # Hit the N block - swap? Let's try swapping
            grid[cr][cc] = 'N'
            grid[nr][nc] = 'b'
            return tuple(tuple(row) for row in grid)
        else:
            # Unknown cell type
            return None
    
    return None

# BFS
initial_grid = build_grid(ascii_lines)
b_pos = find_b(initial_grid)
print("Initial b position:", b_pos)
print("N position: (10, 10)")

# BFS
visited = {initial_grid}
queue = deque([(initial_grid, [])])

directions = [('UP', -1, 0), ('DOWN', 1, 0), ('LEFT', 0, -1), ('RIGHT', 0, 1)]

found = False
while queue:
    grid, path = queue.popleft()
    b_pos = find_b(grid)
    
    if b_pos == (9, 10):  # Position above N, ready to press DOWN
        print("Found path to (9,10)! Length:", len(path))
        print("Path:", path)
        found = True
        break
    
    if len(path) > 30:
        continue
    
    for action_name, dr, dc in directions:
        new_grid = slide(grid, b_pos[0], b_pos[1], dr, dc)
        if new_grid is not None and new_grid not in visited:
            visited.add(new_grid)
            queue.append((new_grid, path + [action_name]))

if not found:
    print("No path found to (9,10)")
    # Try (10,10) directly
    visited2 = {initial_grid}
    queue2 = deque([(initial_grid, [])])
    while queue2:
        grid, path = queue2.popleft()
        b_pos = find_b(grid)
        if b_pos == (10, 10):
            print("Found path to (10,10)! Length:", len(path))
            print("Path:", path)
            found = True
            break
        if len(path) > 30:
            continue
        for action_name, dr, dc in directions:
            new_grid = slide(grid, b_pos[0], b_pos[1], dr, dc)
            if new_grid is not None and new_grid not in visited2:
                visited2.add(new_grid)
                queue2.append((new_grid, path + [action_name]))
    if not found:
        print("No path found to (10,10) either")
        print("Visited states:", len(visited))
