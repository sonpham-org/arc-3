# We saw UP changes symbols at columns 15,29,43. DOWN did not change.
# Maybe UP swaps with top grid symbol in same column? Let's map column indices.
# Selector cols 15,22,29,36,43 correspond to pink bar indices 0-4.
# UP changed index0 from b4edb3... to cddd7... which matches top pink symbol at (4,22) cddd7... Indeed top (4,22) is cddd7.
# Index2 changed from b4edb3... to cddd7... Wait index2 changed to cddd7 as well. That seems odd. Maybe we are moving selector incorrectly? Let's re-evaluate.
# Let's just get current state and see top symbols.
def get_pink_hashes(frame):
    nodes=frame.segmentation['nodes']
    id_to_node={n['id']:n for n in nodes}
    pink_bar=next((n for n in nodes if n['color']=='P' and any(p[0]>=51 and p[0]<=55 for p in n['boundary'])), None)
    return [id_to_node[c]['hash'] for c in pink_bar['children']] if pink_bar else []
def get_white_col(frame):
    nodes=frame.segmentation['nodes']
    for n in nodes:
        if n['color']=='W':
            b=n['boundary']
            return min(p[1] for p in b)
    return None
print('white col', get_white_col(current_frame))
print('pink', get_pink_hashes(current_frame))
# Let's get top map again
top_map={}
for n in current_frame.segmentation['nodes']:
    if n['color'] in ('S','P') and len(n['children'])==1 and any(p[0]<=25 for p in n['boundary']):
        b=n['boundary']
        r=min(p[0] for p in b)
        c=min(p[1] for p in b)
        child_id=n['children'][0]
        child=next(m for m in current_frame.segmentation['nodes'] if m['id']==child_id)
        top_map[(r,c)]=child['hash']
print(top_map)
