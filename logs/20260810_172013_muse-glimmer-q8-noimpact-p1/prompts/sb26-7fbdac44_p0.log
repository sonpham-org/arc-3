def get_inner(frame):
    nodes = frame.segmentation['nodes']
    reds = [n for n in nodes if n['color']=='R']
    red = reds[0]
    inner_id = red['children'][0]
    inner = nodes[inner_id]
    slots = []
    for cid in inner['children']:
        n = nodes[cid]
        slots.append((nodes[cid]['boundary'][0][1], n['color']))
    slots.sort()
    return [c for _,c in slots]

def bottom_small(frame):
    nodes = frame.segmentation['nodes']
    small = [n for n in nodes if n['boundary'][0][0]>=55 and n['boundary'][0][0]<=62 and n['pixels']<=30]
    small.sort(key=lambda n: n['boundary'][0][1])
    return [n['color'] for n in small]

