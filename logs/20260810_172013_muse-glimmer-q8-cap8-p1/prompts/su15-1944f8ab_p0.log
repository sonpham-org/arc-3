def crop(ascii_str, r0,c0,h,w):
    lines=ascii_str.split('\n')
    out=[]
    for i in range(r0, r0+h):
        line=lines[i] if i<len(lines) else ''
        out.append(line[c0:c0+w])
    return '\n'.join(out)

