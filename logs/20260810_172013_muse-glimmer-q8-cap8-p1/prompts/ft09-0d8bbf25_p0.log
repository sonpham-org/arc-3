def get_reds(frame,center):
    nodes=frame.segmentation['nodes']
    rc,cc=center
    reds=set()
    for n in nodes:
        if n['color']=='R':
            b=n['boundary']
            rmin=min(p[0] for p in b); rmax=max(p[0] for p in b)
            cmin=min(p[1] for p in b); cmax=max(p[1] for p in b)
            rcen=(rmin+rmax)//2
            ccen=(cmin+cmax)//2
            if abs(rcen-rc)<=18 and abs(ccen-cc)<=18:
                r_idx=round((rcen-rc+8)/8)
                c_idx=round((ccen-cc+8)/8)
                if 0<=r_idx<3 and 0<=c_idx<3:
                    reds.add((r_idx,c_idx))
    return reds

