            if ch in ('r', 'B'):
                obstacles.add((r, c))

# Current blue position
seg = current_frame.segmentation
for n in seg['nodes']:
    if n['color'] == 'S':
        b = n['boundary']
        start = (min([p[0] for p in b]), min([p[1] for p in b]))

goal = (45, 28)

def is_valid(pos):
    r, c = pos
    for dr in range(4):
        for dc in range(4):
            if (r+dr, c+dc) in obstacles:
                return False
    return True

print(f"Start: {start}, valid: {is_valid(start)}")
print(f"Goal: {goal}, valid: {is_valid(goal)}")
