def get_bar(seg):
    red = 0
    green = 0
    gray = 0
    for n in seg['nodes']:
        if any(p[0] < 3 for p in n['boundary']):
            b = n['boundary']
            cols = [p[1] for p in b]
            if n['color'] == 'R':
                red += 1
            elif n['color'] == 'N':
                green = max(cols) - min(cols) + 1
            elif n['color'] == 'G':
                gray = max(cols) - min(cols) + 1
    return red, green, gray

