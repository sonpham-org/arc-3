# Python build / env artifacts
.venv/
__pycache__/
*.pyc
*.egg-info/
.ruff_cache/
.pytest_cache/

# Runtime caches (created by `make`/`make view`)
.cache/
runs/
reports/

# Generated ARC3 artifacts. Raw runs are durable in GCS; normalized viewer
# exports are published directly to Railway's /srv/data volume.
logs/*
!logs/README.md
docs/data/*
!docs/data/README.md

# Node (figure tooling, if reintroduced)
node_modules/

# Secrets / local env
.env

# OS
.DS_Store

# Kaggle competition data (redistributable only via the competition; keep out of git)
environment_files/

# Decision-step corpus: recordings are 70-140 MB apiece and are re-pulled by the scraper.
datasets/decision-steps/v0/recordings/
# ...and the same path as a SYMLINK, which the trailing slash above does not match. A
# worktree that links this dir to another checkout's copy would otherwise stage the link.
datasets/decision-steps/v0/recordings
datasets/decision-steps/v0/frame-cache/

# Decision-step corpus: unfinished pass-A output. A candidate is missing its judgment
# fields on purpose and must never be committed or mistaken for a finished record.
datasets/decision-steps/v0/episodes/*.candidate.jsonl

# Vendor-agent coherence corpus. Compact per-step JSONL stripped from 10-90 MB recordings by
# tools/harvest_replays.py, plus the reasoning-only distillation. Re-pullable from the public
# API; ~580 MB and growing. README.md and any tracked analysis output stay visible.
datasets/vendor-coherence/replays/
datasets/vendor-coherence/replays
datasets/vendor-coherence/reasoning/
datasets/vendor-coherence/reasoning
datasets/vendor-coherence/samples/
datasets/vendor-coherence/samples

# The 25 public games' write-ups, fetched from arc-explainer by tools/fetch_explainer_games.py.
# arc-explainer is the only place they are edited; this is a cache, re-fetched for corrections.
datasets/explainer-games/

# Scorecard pulls from tools/pull_boss_scorecards.py. Timestamped raw dumps of one account's
# play history, regenerable in a minute; the durable artifact is the inventory write-up in
# docs/trace-findings/. README and any guid lists stay visible.
datasets/decision-steps/scorecards/cards-*.json
datasets/decision-steps/scorecards/runs-*.json

# Derived analysis output from tools/analyze_coherence.py; regenerated on every run.
datasets/vendor-coherence/coherence-rows.json
