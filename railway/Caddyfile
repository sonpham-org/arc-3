# Static site server. oauth2-proxy is the only public listener and forwards
# authenticated internal requests to this loopback service.
:8081
root * /srv
encode zstd gzip

@catalog path /data/runs-index.json /api/*
reverse_proxy @catalog 127.0.0.1:8082

file_server

@html path / /*.html
header @html Cache-Control "no-store, max-age=0"
header /data/runs-index.json Cache-Control "no-store, max-age=0"
@immutable_data {
  path /data/*
  not path /data/runs-index.json
}
header @immutable_data Cache-Control "public, max-age=3600"
header /static/* Cache-Control "public, max-age=300"
