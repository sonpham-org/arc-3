{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arc3.sonpham.net/schemas/alternative-game-v1.json",
  "title": "Alternative ARC3 benchmark game",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "game_id",
    "version",
    "internal_title",
    "author_partition",
    "authorship",
    "inspiration",
    "mechanics",
    "failure_modes",
    "interface",
    "progression",
    "visual_identity",
    "evaluation",
    "artifacts",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "game_id": {"type": "string", "pattern": "^[a-z0-9]{4}$"},
    "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "internal_title": {"type": "string", "minLength": 1},
    "public_title": {"type": ["string", "null"]},
    "author_partition": {"enum": ["gpt", "anthropic"]},
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_family", "model_snapshot", "session_id", "created_at", "source_lineage"],
      "properties": {
        "model_family": {"type": "string"},
        "model_snapshot": {"type": "string"},
        "session_id": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "source_lineage": {"type": "array", "items": {"type": "string"}},
        "source_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "inspiration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_ids", "relationship", "structural_difference", "excluded_reuse"],
      "properties": {
        "lineage_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^f[0-9]{3}$"},
          "uniqueItems": true
        },
        "relationship": {"type": "string", "minLength": 20},
        "structural_difference": {"type": "string", "minLength": 40},
        "excluded_reuse": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3},
          "uniqueItems": true
        }
      }
    },
    "mechanics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "novelty_claim", "closest_prior_art"],
      "properties": {
        "primary": {"type": "string"},
        "secondary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "novelty_claim": {"type": "string", "minLength": 40},
        "closest_prior_art": {"type": "array", "items": {"type": "string"}}
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "observation", "deterministic"],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1, "maximum": 7},
          "uniqueItems": true
        },
        "observation": {"const": "64x64x16"},
        "deterministic": {"type": "boolean"},
        "seeded_stochasticity": {"type": "boolean", "default": false}
      }
    },
    "progression": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "role", "new_demand", "composes"],
        "properties": {
          "level": {"type": "integer", "minimum": 1},
          "role": {"enum": ["orient", "discriminate", "plan", "remember", "compose", "inhibit", "transfer", "synthesize"]},
          "new_demand": {"type": "string"},
          "composes": {"type": "array", "items": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "visual_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dominant_palette", "silhouette_grammar", "spatial_grammar", "motion_grammar", "hud_grammar"],
      "properties": {
        "dominant_palette": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 15}},
        "silhouette_grammar": {"type": "string"},
        "spatial_grammar": {"type": "string"},
        "motion_grammar": {"type": "string"},
        "hud_grammar": {"type": "string"},
        "nearest_visual_games": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_development_models", "held_out_evaluator", "human_baseline_status"],
      "properties": {
        "allowed_development_models": {"type": "array", "items": {"type": "string"}},
        "held_out_evaluator": {"enum": ["gpt", "anthropic"]},
        "human_baseline_status": {"enum": ["not_started", "pilot", "qualified"]},
        "held_out_status": {"enum": ["sealed", "running", "complete", "invalidated"]}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "metadata", "win_recording", "loss_recording"],
      "properties": {
        "source": {"type": "string"},
        "metadata": {"type": "string"},
        "win_recording": {"type": "string"},
        "loss_recording": {"type": "string"},
        "thumbnail": {"type": ["string", "null"]},
        "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "status": {"enum": ["idea", "specified", "prototype", "qualified", "human_tested", "sealed", "released", "rejected"]}
  }
}
