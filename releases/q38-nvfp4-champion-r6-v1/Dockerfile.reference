ARG KAGGLE_BASE=gcr.io/kaggle-private-byod/python@sha256:57e612b484cf3df5026ee4dcc3cb176974b22b2bc0937fb1e16132a8be4cb13c
FROM ${KAGGLE_BASE}

# Reference/CI image only. Kaggle runs its own notebook image; it does not run
# this Dockerfile. Mount or copy the separately versioned 195-wheel GCP closure
# at build time, then verify/install it exactly as the Kaggle setup script does.
COPY kaggle/ /opt/arc3-release/kaggle/
COPY artifacts/engine-wheels/ /opt/arc3-release/engine-wheels/
COPY CHAMPION_LOCK.json /opt/arc3-release/CHAMPION_LOCK.json
WORKDIR /opt/arc3-release

RUN python -m pip install --no-index --no-deps --force-reinstall \
      engine-wheels/arc_agi-0.9.8-py3-none-any.whl \
      engine-wheels/arcengine-0.9.3-py3-none-any.whl && \
    python -c "from importlib.metadata import version; assert version('arc-agi') == '0.9.8'; assert version('arcengine') == '0.9.3'"

CMD ["python", "-m", "py_compile", "kaggle/kaggle_nvfp4_world_model_setup.py"]
