[Unit]
Description=ARC Debugger context-fork gateway
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/arc-debugger/ARC3-Inference
Environment=PYTHONUNBUFFERED=1
Environment=ARC3_DEBUGGER_ALLOWED_ORIGINS=https://arc3.sonpham.net
Environment=ARC3_DEBUGGER_CLUSTER_NODES=a108,a424
EnvironmentFile=-%h/.config/arc-debugger.env
ExecStart=/usr/bin/python3 -m debugger.server --port 8033 --model-base-url http://127.0.0.1:1234/v1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
